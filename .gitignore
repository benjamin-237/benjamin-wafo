# Sauvegardes locales à la racine
/*.bak*
/*.avant*
/*sauvegarde*
/*backup*

# Environnement Python local
/.venv-educore-pdf/

# Vidéos originales : conserver les versions compressées pour le site
/media/cybetcare/videos/
/media/educore/videos/
